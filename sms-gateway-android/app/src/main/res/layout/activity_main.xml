<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F8FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEO COFFEE" android:textColor="#123E70" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="28dp" android:text="SMS Gateway" android:textColor="#64748B" android:textSize="16sp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="رابط الموقع المنشور" android:textStyle="bold"/><EditText android:id="@+id/siteUrl" android:layout_width="match_parent" android:layout_height="56dp" android:hint="https://store.example.com" android:inputType="textUri" android:layoutDirection="ltr"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="مفتاح الجهاز" android:textStyle="bold"/><EditText android:id="@+id/deviceToken" android:layout_width="match_parent" android:layout_height="56dp" android:hint="SMS_GATEWAY_TOKEN" android:inputType="textPassword" android:layoutDirection="ltr"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="الخط المستخدم في إرسال الرسائل" android:textStyle="bold"/><Spinner android:id="@+id/simChoice" android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:paddingStart="12dp" android:paddingEnd="12dp"/>
 <Button android:id="@+id/saveStart" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="حفظ وتشغيل الإرسال" android:textSize="16sp"/><Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="إيقاف الخدمة"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="اختبار الخط المختار" android:textStyle="bold"/><EditText android:id="@+id/testPhone" android:layout_width="match_parent" android:layout_height="56dp" android:hint="01xxxxxxxxx" android:inputType="phone" android:layoutDirection="ltr"/><Button android:id="@+id/sendTest" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="إرسال رسالة اختبار"/><Button android:id="@+id/confirmTest" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="تأكيد وصول آخر اختبار"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="#FFFFFF" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حالة البوابة" android:textColor="#123E70" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="متوقفة" android:textSize="16sp"/><TextView android:id="@+id/lastActivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#64748B"/></LinearLayout>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="تقرير الرسائل" android:textColor="#123E70" android:textSize="20sp" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/fromDate" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="من"/><Button android:id="@+id/toDate" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="إلى"/></LinearLayout>
 <Button android:id="@+id/showReport" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="عرض التقرير"/>
 <TextView android:id="@+id/reportResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#FFFFFF" android:padding="16dp" android:text="اختر الفترة ثم اضغط عرض التقرير" android:textColor="#334155" android:textIsSelectable="true"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="احتفظ بالهاتف متصلًا بالإنترنت وبالشاحن. سيظهر إشعار دائم أثناء تشغيل خدمة إرسال الأكواد." android:textColor="#64748B" android:textSize="14sp"/>
</LinearLayout></ScrollView>
